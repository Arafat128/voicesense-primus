# Copy to .env. Used only for optional Primus zkTLS — never for the WAV path.

PRIMUS_APP_ID=
# Local test-mode request signing only. Do not ship this in a public host.
PRIMUS_APP_SECRET=

# GitHub / X ownership template from https://dev.primuslabs.xyz/
PRIMUS_UNIQUENESS_TEMPLATE_ID=
PRIMUS_IDENTITY_FIELD=screen_name
# X Account Ownership template so @its_perseus_1 can skip the follow gate
PRIMUS_OWNER_TEMPLATE_ID=
PRIMUS_OWNER_FIELD=screen_name

# X follow-gate: custom Hub template proving following=true for YOUR account
# Do NOT use a plain "Account Ownership" template for this.
PRIMUS_X_FOLLOW_TEMPLATE_ID=
PRIMUS_X_FOLLOW_HANDLE=its_perseus_1
PRIMUS_X_FOLLOW_FIELD=following
PRIMUS_X_FOLLOW_OP==
PRIMUS_X_FOLLOW_VALUE=true

# Optional boolean age/eligibility (zkTLS comparison, app stores true/false)
PRIMUS_AGE_TEMPLATE_ID=
PRIMUS_AGE_FIELD=age
PRIMUS_AGE_OP=>=
PRIMUS_AGE_VALUE=18

# Optional hashed researcher / institution login
PRIMUS_RESEARCHER_TEMPLATE_ID=
PRIMUS_RESEARCHER_FIELD=email

# Optional public GitHub repo JSON (api.github.com) — not model files
PRIMUS_GITHUB_TEMPLATE_ID=
PRIMUS_GITHUB_FIELD=full_name

# proxytls (default) or mpctls if a site blocks proxies
PRIMUS_ATT_MODE=proxytls

# 1 = Analyze blocked until uniqueness fingerprint exists
VOICESENSE_REQUIRE_ENROLLMENT=1
# Operator unlock (not shown on the public page). Leave empty to disable.
VOICESENSE_OPERATOR_PIN=
VOICESENSE_DEV_UI=0

# 1 = show simulate-enrollment (not a real zkTLS proof)
PRIMUS_MOCK=0
